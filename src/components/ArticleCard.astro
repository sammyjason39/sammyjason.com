---
import { CATEGORIES, formatDateID, categoryLabel } from '../lib/site';

interface Props {
  title: string;
  href: string;
  category: string;
  pubDate: Date;
  minutes: number;
  description: string;
}

const { title, href, category, pubDate, minutes, description } = Astro.props;
const cat = CATEGORIES[category];
---

<article class="card card-hover p-6 flex flex-col gap-3 h-full">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-400">
    <a href={`/blog/kategori/${category}/`} class="pill">{cat?.label ?? categoryLabel(category)}</a>
    <time datetime={pubDate.toISOString()}>{formatDateID(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} menit baca</span>
  </div>
  <h3 class="text-lg font-semibold leading-snug text-white">
    <a href={href} class="hover:text-brand-300 transition-colors">{title}</a>
  </h3>
  <p class="text-sm leading-relaxed text-ink-400 line-clamp-3">{description}</p>
  <a
    href={href}
    class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-brand-300 hover:text-brand-400"
  >
    Baca artikel
    <span aria-hidden="true">→</span>
  </a>
</article>