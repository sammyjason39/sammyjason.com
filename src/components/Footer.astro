---
import { NAV_LINKS, ECOSYSTEM_LINKS, SOCIAL_LINKS, SITE_TAGLINE } from '../lib/site';

const year = 2026;
---

<footer class="border-t border-white/8 bg-[#090d18]/60">
  <div class="container-site py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-lg font-semibold text-white">Samz</p>
        <p class="mt-2 text-sm text-ink-300 italic">{SITE_TAGLINE}</p>
        <p class="mt-3 text-xs leading-relaxed text-ink-400">
          CTO Conextlab | N8N Ambassador | Founder Belajar AI
        </p>
      </div>

      <nav aria-label="Jelajah">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400">Jelajah</h2>
        <ul class="mt-4 space-y-2.5">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-300 hover:text-brand-300 transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Ekosistem">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400">Ekosistem</h2>
        <ul class="mt-4 space-y-2.5">
          {
            ECOSYSTEM_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-ink-300 hover:text-brand-300 transition-colors"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-ink-400"> ↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Terhubung">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-400">Terhubung</h2>
        <ul class="mt-4 space-y-2.5">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-ink-300 hover:text-brand-300 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/8 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-400">
        Dibuat dan dirawat sendiri oleh Samz. © {year} Samuel Jason Santosa.
      </p>
      <p class="inline-flex items-center gap-1.5 text-xs text-ink-400">
        <span class="inline-block h-2 w-2 rounded-full bg-brand-500" aria-hidden="true"></span>
        Indonesia (ID)
      </p>
    </div>
  </div>
</footer>