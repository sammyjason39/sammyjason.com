---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, readingTime } from '../lib/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const seedSlugs = [
  'setup-hermes-free-operator',
  'perusahaan-mulai-adaptasi-ai-alur-kerja',
  'anatomi-ai-agent-produksi-conextlab',
];
const featured = seedSlugs
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({
    title: p.data.title,
    href: `/blog/${p.id}/`,
    category: p.data.category,
    pubDate: p.data.pubDate,
    minutes: readingTime(p.body ?? ''),
    description: p.data.description,
  }));

const ecosystem = [
  {
    name: 'Conextlab.ai',
    desc: 'Sistem AI agentic B2B untuk korporasi Indonesia (Intel, Nvidia, Indosat, BPJS Ketenagakerjaan).',
    href: 'https://conextlab.ai',
    wide: true,
  },
  {
    name: 'BelajarAI.id',
    desc: 'Kelas AI praktis, workshop agent, dan RAG untuk profesional.',
    href: 'https://belajarai.id',
    wide: false,
  },
  {
    name: 'ConextRouter',
    desc: 'Gerbang API & router model AI cerdas untuk ConextOS.',
    href: 'https://app.conextrouter.xyz',
    wide: false,
  },
  {
    name: 'Pekerja.AI',
    desc: 'Kurasi talenta AI berbasis portfolio proof.',
    href: 'https://pekerja.ai',
    wide: false,
  },
  {
    name: 'Artifisial.com',
    desc: 'Portal media & ekosistem AI Indonesia.',
    href: 'https://artifisial.com',
    wide: false,
  },
  {
    name: 'n8n Community',
    desc: 'Otomasi alur kerja tingkat lanjut dan kontribusi ekosistem global.',
    href: 'https://n8n.io',
    wide: false,
  },
];

const framework4m = [
  {
    step: '1',
    title: 'Menyadari',
    en: 'Awareness',
    desc: 'AI sudah masuk ke pekerjaanmu. Langkah pertama sehat cuma satu, sadar dan berhenti pura-pura tidak lihat.',
  },
  {
    step: '2',
    title: 'Menerima',
    en: 'Acceptance',
    desc: 'Tidak perlu panik, tidak perlu defensif. AI itu alat kerja baru, bukan vonis pengganti manusia.',
  },
  {
    step: '3',
    title: 'Mengetahui',
    en: 'Knowledge',
    desc: 'Pelajari batasnya, bukan cuma fiturnya. Paham kapan AI menolong dan kapan justru bikin alur kerja berantakan.',
  },
  {
    step: '4',
    title: 'Melangkah',
    en: 'Action',
    desc: 'Pilih satu alur kerja nyata, ukur hasilnya, baru meluas. Kecil tapi jalan jauh lebih bernilai daripada visi besar tanpa eksekusi.',
  },
];

const credibility = [
  'CTO Conextlab (Ralali Group)',
  'N8N Ambassador',
  'Founder Belajar AI (800+ anggota)',
  'Apple Developer Academy Alum',
];
---

<BaseLayout
  title="Samuel Jason, CTO Conextlab & Founder Belajar AI"
  description="Rumah digital Samuel Jason (Samz): catatan lapangan AI, Framework 4M, dan ekosistem produk. CTO Conextlab, N8N Ambassador, Founder Belajar AI. Teman kamu bertumbuh di Era AI."
  path="/"
>
  <section class="container-site pt-16 pb-14 sm:pt-24">
    <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-14">
      <div class="relative mx-auto lg:mx-0">
        <div class="absolute inset-0 rounded-full bg-brand-400/15 blur-2xl" aria-hidden="true"></div>
        <Avatar size={168} class="relative ring-1 ring-stone-300/80 shadow-[0_20px_60px_-25px_rgba(10,10,10,0.35)]" />
      </div>
      <div>
        <p class="pill mb-5">
          <span class="inline-block h-2 w-2 rounded-full bg-brand-400" aria-hidden="true"></span>
          Tersedia untuk sesi konsultasi &amp; diskusi Q4 2026
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Teman kamu bertumbuh di Era AI.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-300">
          Saya Samz. CTO Conextlab, N8N Ambassador, dan pembina komunitas Belajar AI. Di sini saya
          bagikan cara bikin AI benar-benar kerja untuk bisnis dan kariermu, tanpa hype.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontak/" class="btn btn-primary">Mulai ngobrol</a>
          <a href="/blog/" class="btn btn-secondary">Baca blog</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-site" aria-label="Kredibilitas">
    <div class="card px-6 py-4">
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm font-medium text-ink-300">
        {
          credibility.map((item, i) => (
            <li class="flex items-center gap-3">
              {i > 0 && <span class="text-ink-400" aria-hidden="true">·</span>}
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container-site pt-20">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Ekosistem &amp; Karya Utama</h2>
      <p class="mt-3 text-ink-400">Sistem yang saya bangun, uji, dan rawat di produksi nyata.</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        ecosystem.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'card card-hover group p-6 flex flex-col gap-2',
              item.wide && 'md:col-span-2',
            ]}
          >
            <span class="flex items-center justify-between">
              <span class="text-base font-semibold text-white">{item.name}</span>
              <span
                class="text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-300"
                aria-hidden="true"
              >
                ↗
              </span>
            </span>
            <span class="text-sm leading-relaxed text-ink-400">{item.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-site pt-20">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Bagaimana saya melihat adopsi AI: Framework 4M
      </h2>
      <p class="mt-3 text-ink-400">
        Bukan beli software mahal lalu berharap keajaiban. Empat fase realistis dari tidak tahu
        sampai menghasilkan.
      </p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        framework4m.map((fase) => (
          <div class="card p-6">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500/15 text-sm font-bold text-brand-300">
                {fase.step}
              </span>
              <div>
                <p class="font-semibold text-white">{fase.title}</p>
                <p class="text-xs text-ink-400">{fase.en}</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-ink-300">{fase.desc}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-6">
      <a href="/blog/kategori/framework-4m/" class="btn btn-secondary btn-sm">
        Baca implementasi 4M
      </a>
    </div>
  </section>

  <section class="container-site pt-20">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Artikel Pilihan</h2>
      <p class="mt-3 text-ink-400">Catatan lapangan terbaru dari meja kerja.</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        featured.map((post) => (
          <ArticleCard
            title={post.title}
            href={post.href}
            category={post.category}
            pubDate={post.pubDate}
            minutes={post.minutes}
            description={post.description}
          />
        ))
      }
    </div>
  </section>

  <section class="container-site py-20">
    <div class="card card-accent border-brand-400/30 p-8 sm:p-12">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Punya ide sistem AI atau alur kerja yang ingin dirapikan?
      </h2>
      <p class="mt-3 max-w-2xl text-ink-300">
        Baik untuk kebutuhan transformasi tim perusahaan atau diskusi seputar eksperimen
        teknologi, mari ngobrol santai.
      </p>
      <a href="/kontak/" class="btn btn-primary mt-6">Jadwalkan Ngobrol</a>
    </div>
  </section>
</BaseLayout>