---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan"
  description="Halaman yang kamu cari tidak ada atau sudah dipindah. Jelajahi blog atau mulai ngobrol dari halaman utama."
  path="/404.html"
  noindex={true}
  includePersonJsonLd={false}
>
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="pill mb-6">Error 404</p>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
      Halaman tidak ditemukan.
    </h1>
    <p class="mt-5 max-w-md text-ink-300">
      Alamat yang kamu buka tidak ada atau sudah dipindah. Tenang, bagian terbaik situs ini masih
      di depan.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Ke halaman utama</a>
      <a href="/blog/" class="btn btn-secondary">Baca blog</a>
      <a href="/kontak/" class="btn btn-secondary">Mulai ngobrol</a>
    </div>
  </section>
</BaseLayout>