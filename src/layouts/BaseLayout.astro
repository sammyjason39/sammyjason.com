---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import type { PageSeoProps } from '../components/Seo.astro';

interface Props extends PageSeoProps {
  includePersonJsonLd?: boolean;
}

const {
  includePersonJsonLd = true,
  title,
  description,
  path,
  ogType,
  ogImage,
  noindex,
  publishedTime,
  modifiedTime,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      ogImage={ogImage}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    {includePersonJsonLd && <PersonJsonLd />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="alternate" type="application/rss+xml" title="Blog Samuel Jason" href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#konten-utama" class="skip-link">Langsung ke konten utama</a>
    <Header />
    <main id="konten-utama" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>